# cp deploy/deploy.env.example deploy/deploy.env 후 값을 채운다. deploy.env는 커밋하지 않는다.
DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=22
DEPLOY_USER=footnote-deployer
DEPLOY_KEY=$HOME/.ssh/footnote_deploy
DEPLOY_DIR=/var/local/footnote
# 앱과 사진 presigned URL이 쓰는 공개 도메인(nginx가 8443=API, 8444=S3로 받는다)
PUBLIC_HOST=api.example.com
