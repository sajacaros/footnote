# cp .env.example .env 후 값을 바꾼다. .env는 커밋하지 않는다.
POSTGRES_PASSWORD=footnote
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
S3_ACCESS_KEY=footnote
S3_SECRET_KEY=footnote-secret
S3_BUCKET=footnote

# 폰이 접속하는 S3 주소(presigned URL 서명에 쓰임)
S3_PUBLIC_ENDPOINT=http://localhost:8333

# 서버 배포 시 외부 공개가 필요하면 0.0.0.0으로 바꾼다.
API_BIND=127.0.0.1
API_PORT=8000
S3_BIND=127.0.0.1
S3_PORT=8333
DB_PORT=15433

# 로컬에서 uvicorn/pytest를 직접 돌릴 때 쓰는 값
DATABASE_URL=postgresql+asyncpg://footnote:footnote@localhost:15433/footnote
S3_ENDPOINT=http://localhost:8333
